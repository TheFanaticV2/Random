rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function event() { return get(/databases/$(database)/documents/events/main).data; }
    function afterEvent() { return getAfter(/databases/$(database)/documents/events/main).data; }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /events/main {
      allow get: if signedIn();
      allow create: if admin() && request.resource.data == {'count': 0, 'open': true};
      allow update: if admin() || (
        signedIn() && resource.data.open == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0 && request.resource.data.count <= 30
        && (
          (request.resource.data.count == resource.data.count + 1
            && !exists(/databases/$(database)/documents/events/main/participants/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/events/main/participants/$(request.auth.uid)))
          || (request.resource.data.count == resource.data.count - 1
            && exists(/databases/$(database)/documents/events/main/participants/$(request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/events/main/participants/$(request.auth.uid)))
        )
      );
      match /participants/{uid} {
        allow get: if admin() || (signedIn() && request.auth.uid == uid);
        allow list: if admin();
        allow create: if signedIn() && request.auth.uid == uid
          && event().open == true && event().count < 30
          && afterEvent().count == event().count + 1
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.name.matches('.*[^ ].*')
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid
          && event().open == true && afterEvent().count == event().count - 1;
        allow update: if false;
      }
      match /private/{document} { allow read, write: if admin(); }
    }
  }
}
